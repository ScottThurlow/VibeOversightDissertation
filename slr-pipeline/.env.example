# Project-scoped credentials for the Vibe Coding Governance SLR.
# Copy to a .env at this repo's root (gitignored), or point ZOTERO_ENV_FILE at it.
# Scripts walk up from CWD to the repo root to find .env, so different projects
# in different working trees keep different keys. chmod 600 the real file.
ZOTERO_LIBRARY_ID=6505702
ZOTERO_LIBRARY_TYPE=group

# Read-only key — used by diagnostics, dry runs, screening reads
ZOTERO_API_KEY=your_read_only_key_here

# Write key — OPTIONAL here. Safer to pass inline only at apply time:
#   ZOTERO_WRITE_KEY=xxxx python3 restore_pass1_from_csv.py ... --apply
# If set here, the destructive credential rests on disk.
# ZOTERO_WRITE_KEY=your_write_key_here
